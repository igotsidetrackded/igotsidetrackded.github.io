---
// src/pages/resume.astro
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Resume | Bryan Schauer"
  description="Senior Staff DevSecOps Engineer specializing in Cloud Architecture, Platform Security, and Secure Systems Engineering."
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Resume | Bryan Schauer</title>
    <head>
      <meta charset="UTF-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1.0" />
      <title>Resume | Bryan Schauer</title>
      <style>
        @media print {
          @page {
            margin: 0.35in;
            size: letter;
          }

          /* Force plain white background and dark text globally */
          body {
            background-color: #ffffff !important;
            color: #0f172a !important;
            font-size: 10px !important;
            line-height: 1.3 !important;
            -webkit-print-color-adjust: exact;
          }

          /* Clean up main container padding for print */
          main.max-w-4xl {
            padding: 0 !important;
            margin: 0 !important;
          }

          /* Controlled vertical spacing between sections */
          section {
            margin-top: 1.1rem !important;
            margin-bottom: 0 !important;
          }

          /* Force EVERY text element to be crisp dark slate */
          p,
          li,
          span,
          a,
          h1,
          h2,
          h3,
          h4,
          div {
            color: #0f172a !important;
          }

          /* Headers spacing & page-break rules */
          h1 {
            font-size: 16px !important;
          }
          h2 {
            font-size: 12.5px !important;
            font-weight: bold !important;
            margin-top: 0 !important;
            margin-bottom: 0.25rem !important;
            break-after: avoid !important;
            page-break-after: avoid !important;
          }
          h3 {
            font-size: 10.5px !important;
            font-weight: bold !important;
            margin-top: 0 !important;
            margin-bottom: 0.15rem !important;
            break-after: avoid !important;
            page-break-after: avoid !important;
          }

          /* Paragraphs and list items */
          p,
          li {
            font-size: 9.5px !important;
            margin-bottom: 0.2rem !important;
          }

          /* 2-column grid layout for competencies and education */
          .grid {
            display: grid !important;
            gap: 0.4rem !important;
          }
          .grid-cols-1.md\:grid-cols-2 {
            grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
          }

          /* Prevent individual job blocks from breaking awkwardly */
          section > div.space-y-3,
          .space-y-8 > div {
            break-inside: avoid !important;
            page-break-inside: avoid !important;
          }

          /* Card container styling */
          .bg-slate-900,
          .bg-slate-900\/50 {
            background-color: #f8fafc !important;
            border: 1px solid #cbd5e1 !important;
            padding: 0.35rem 0.55rem !important;
            border-radius: 4px !important;
          }

          /* General container and border cleanup */
          main,
          div {
            background-color: transparent !important;
            border-color: #cbd5e1 !important;
          }

          /* Size down header links */
          header .flex.flex-wrap.gap-3 a {
            font-size: 8px !important;
            padding: 1px 4px !important;
            border-radius: 3px !important;
            border: 1px solid #94a3b8 !important;
            background-color: transparent !important;
          }

          /* TECHNICAL TOOLBOX INLINE PILLS */
          .flex.flex-wrap.gap-2 {
            display: block !important;
            margin-top: 0.25rem !important;
          }

          .rounded-full {
            border: 1px solid #cbd5e1 !important;
            background-color: #f8fafc !important;
            font-size: 8px !important;
            padding: 1px 5px !important;
            display: inline-block !important;
            white-space: nowrap !important;
            margin-right: 4px !important;
            margin-bottom: 3px !important;
          }

          /* Hide web-only elements */
          .print\:hidden {
            display: none !important;
          }

          a {
            color: #0369a1 !important;
            text-decoration: none;
          }
        }
      </style>
    </head>
  </head>
  <main class="max-w-4xl mx-auto px-6 py-12 space-y-12">
    <!-- NAVIGATION & HEADER -->
    <header class="space-y-6 border-b border-slate-800 pb-8">
      <a
        href="/"
        class="inline-flex items-center text-sm font-medium text-sky-400 hover:text-sky-300 transition print:hidden"
      >
        ← Back to main site
      </a>

      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div>
          <h1 class="text-4xl font-extrabold text-white tracking-tight">
            Bryan Schauer
          </h1>
          <p class="text-lg font-medium text-sky-400 mt-1">
            DevSecOps Engineer | Cloud Architecture | Platform Security
          </p>
          <p class="text-sm text-slate-300 mt-1">
            Washington, DC • bryan.schauer@gmail.com
          </p>
        </div>

        <div class="flex flex-wrap gap-3 text-sm">
          <a
            href="https://www.linkedin.com/in/schauebc"
            target="_blank"
            rel="noopener noreferrer"
            class="px-3 py-1.5 bg-slate-900 border border-slate-800 rounded-md text-slate-300 hover:text-white hover:border-slate-700 transition"
          >
            LinkedIn
          </a>
          <a
            href="https://www.github.com/igotsidetrackded"
            target="_blank"
            rel="noopener noreferrer"
            class="px-3 py-1.5 bg-slate-900 border border-slate-800 rounded-md text-slate-300 hover:text-white hover:border-slate-700 transition"
          >
            GitHub
          </a>
          <a
            href="https://www.schauermayhew.com"
            target="_blank"
            rel="noopener noreferrer"
            class="px-3 py-1.5 bg-slate-900 border border-slate-800 rounded-md text-slate-300 hover:text-white hover:border-slate-700 transition"
          >
            Personal Site
          </a>
        </div>
      </div>
    </header>

    <!-- SUMMARY -->
    <section class="space-y-3">
      <h2 class="text-xl font-bold text-white border-l-4 border-sky-400 pl-3">
        Summary
      </h2>
      <p class="text-slate-300 leading-relaxed text-sm sm:text-base">
        Senior Staff DevSecOps Engineer with 15+ years of experience building,
        securing, and scaling cloud platforms across SaaS environments.
        Expertise spans AWS, Kubernetes, Snowflake, Python, Infrastructure as
        Code (CloudFormation, Terraform, OpenTofu), CI/CD (Jenkins, ArgoCD),
        observability (New Relic, ELK), and cost optimization. Proven track
        record deploying cutting-edge AI integrations—including Decile’s hosted
        MCP server on EKS, featured in the Claude Connector Directory—as well as
        leading multi-account AWS migrations, SSO access management, and SOC 2
        Type II compliance. Began as a data/pipeline engineer and now partners
        across engineering, finance, HR, and operations to turn manual workflows
        into secure, self-serve systems while fostering sustainable work
        culture.
      </p>
    </section>

    <!-- ACHIEVEMENTS SUMMARY -->
    <section class="space-y-3">
      <h2 class="text-xl font-bold text-white border-l-4 border-sky-400 pl-3">
        Achievements Summary
      </h2>
      <ul class="list-disc list-outside pl-5 space-y-2 text-sm text-slate-300 leading-relaxed">
        <li>
          Deployed Decile's hosted MCP server on EKS, giving LLM clients such as
          Claude governed access to customer segmentation and order analytics.
          Listed in the Claude Connector Directory.
        </li>
        <li>
          Secured the MCP service with layered controls: GuardDuty EKS audit and
          runtime monitoring, CrowdStrike Falcon, Orca (SideScanning and
          Sensor), and New Relic and Sentry observability.
        </li>
        <li>
          Led SOC 2 Type II audit readiness and evidence collection, and owned
          vendor management and security posture.
        </li>
        <li>
          Ran vendor evaluations and build-vs-buy decisions across security,
          observability and data tooling. After ramping up Terraform usage,
          migrated from Terraform Cloud to S3 backend using OpenTofu to save
          $35k annually
        </li>
      </ul>
    </section>

    <!-- CORE COMPETENCIES -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-white border-l-4 border-sky-400 pl-3">
        Core Competencies
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="bg-slate-900 p-4 rounded-lg border border-slate-800">
          <h3 class="text-sm font-semibold text-sky-400 uppercase tracking-wider mb-2">
            AI & Platform
          </h3>
          <p class="text-xs text-slate-300 leading-relaxed">
            MCP server design and hosting, Claude Team administration, LLM
            tool/function calling, Kubernetes (EKS), GuardDuty, CrowdStrike,
            Orca, Sentry
          </p>
        </div>
        <div class="bg-slate-900 p-4 rounded-lg border border-slate-800">
          <h3 class="text-sm font-semibold text-sky-400 uppercase tracking-wider mb-2">
            Cloud & Infrastructure
          </h3>
          <p class="text-xs text-slate-300 leading-relaxed">
            AWS, VPC, IAM/SSO, CloudFormation, Terraform, Jenkins, Docker, Chef,
            Ubuntu
          </p>
        </div>
        <div class="bg-slate-900 p-4 rounded-lg border border-slate-800">
          <h3 class="text-sm font-semibold text-sky-400 uppercase tracking-wider mb-2">
            Data & Observability
          </h3>
          <p class="text-xs text-slate-300 leading-relaxed">
            ELK/Logstash, New Relic, Snowflake, dbt Cloud, CloudWatch
          </p>
        </div>
        <div class="bg-slate-900 p-4 rounded-lg border border-slate-800">
          <h3 class="text-sm font-semibold text-sky-400 uppercase tracking-wider mb-2">
            Security & Compliance
          </h3>
          <p class="text-xs text-slate-300 leading-relaxed">
            Orca, Qualys, Snyk, secret management (HashiCorp Vault), SOC 2
            evidence collection
          </p>
        </div>
        <div class="bg-slate-900 p-4 rounded-lg border border-slate-800">
          <h3 class="text-sm font-semibold text-sky-400 uppercase tracking-wider mb-2">
            Programming & Practices
          </h3>
          <p class="text-xs text-slate-300 leading-relaxed">
            Python, Bash, DevOps, DevSecOps, CI/CD, cost optimization, incident
            response, infrastructure resilience
          </p>
        </div>
      </div>
    </section>

    <!-- PROFESSIONAL EXPERIENCE -->
    <section class="space-y-8">
      <h2 class="text-xl font-bold text-white border-l-4 border-sky-400 pl-3">
        Professional Experience
      </h2>

      <!-- Decile - Senior Staff DevSecOps -->
      <div class="space-y-3">
        <div class="flex flex-col sm:flex-row sm:items-baseline justify-between border-b border-slate-800/80 pb-2">
          <div>
            <h3 class="text-lg font-bold text-white">
              Senior Staff DevSecOps Engineer
            </h3>
            <p class="text-sm font-medium text-sky-400">
              Decile <span class="text-slate-400">•</span> Washington, DC
            </p>
          </div>
          <span class="text-xs text-slate-300 font-mono mt-1 sm:mt-0">
            Jul 2020 – Present
          </span>
        </div>
        <p class="text-xs font-mono text-slate-300">
          Technologies: AWS, Docker, Python, Bash, Terraform/OpenTofu, Jenkins,
          Chef, Logstash, New Relic, CloudFormation, Snowflake, dbt Cloud,
          Kubernetes (EKS), ArgoCD
        </p>
        <ul class="list-disc list-outside pl-5 space-y-1.5 text-sm text-slate-300">
          <li>
            Deployed Decile's hosted Model Context Protocol (MCP) server on
            Amazon EKS, securely exposing customer and order analytics to Claude
            and other LLM clients; successfully listed in the official Claude
            Connector Directory.
          </li>
          <li>
            Led AWS modernization and multi-account migration following spinout
            from SocialCode; established secure boundaries, centralized
            governance, and standardized provisioning.
          </li>
          <li>
            Implemented SSO for user accounts, streamlining access and reducing
            operational overhead; tightened RBAC and auditability.
          </li>
          <li>
            Built DRY CloudFormation templates for microservices to eliminate
            configuration drift and accelerate environment creation; improved
            reuse and consistency across dev, pre-prod, and prod.
          </li>
          <li>
            Introduced Terraform with reusable modules; integrated Snowflake and
            dbt Cloud providers to bring analytics infrastructure under IaC
            management.
          </li>
          <li>
            Owned custom Jenkins CI/CD pipeline: automated dev deployments
            post–code review; simplified release management to pre-prod and prod
            via GitHub webhooks and gated approvals.
          </li>
          <li>
            Consolidated observability in New Relic for logs, APM, metrics, and
            alerting; reduced tool sprawl while increasing visibility and
            response speed.
          </li>
          <li>
            Optimized cloud unit economics and stabilized monthly hosting costs
            via rightsizing, Savings Plans/Reservations, and AWS Billing/Cost
            Explorer reporting to Finance and leadership.
          </li>
          <li>
            Monitored and remediated security findings using Orca, Qualys, Snyk,
            and native AWS services; improved vulnerability SLAs and posture.
          </li>
          <li>
            Mentored Engineering and Data Science teams on DevSecOps best
            practices; participated in annual incident response exercises.
          </li>
          <li>
            Coordinated SOC 2 audit evidence collection, mapping controls to
            systems and workflows; reduced audit cycle friction.
          </li>
        </ul>
        <div class="bg-slate-900/50 p-3 rounded border border-slate-800 text-xs text-slate-300 space-y-1">
          <span class="font-semibold text-sky-400">Key Achievements:</span>
          <p>
            • Owning vendor decisions, cross-functional tooling rollouts, and
            company-wide compliance (SOC 2 Type II) to bridge engineering,
            finance, HR, and operations.
          </p>
          <p>
            • Cut variable cloud costs per client while maintaining performance
            SLAs through targeted rightsizing and reservation strategies.
          </p>
          <p>
            • Reduced deployment lead time with automated pipelines and
            standardized templates, improving release predictability.
          </p>
        </div>
      </div>

      <!-- Decile - Head of Culture -->
      <div class="space-y-3">
        <div class="flex flex-col sm:flex-row sm:items-baseline justify-between border-b border-slate-800/80 pb-2">
          <div>
            <h3 class="text-lg font-bold text-white">Head of Culture</h3>
            <p class="text-sm font-medium text-sky-400">
              Decile <span class="text-slate-400">•</span> Washington, DC
            </p>
          </div>
          <span class="text-xs text-slate-300 font-mono mt-1 sm:mt-0">
            Jul 2020 – Present
          </span>
        </div>
        <ul class="list-disc list-outside pl-5 space-y-1.5 text-sm text-slate-300">
          <li>
            Led company culture and DEI programming, with periodic all-hands
            updates.
          </li>
        </ul>
        <div class="bg-slate-900/50 p-3 rounded border border-slate-800 text-xs text-slate-300">
          <span class="font-semibold text-emerald-400">Impact:</span> Increased
          employee participation in culture programs and improved team sentiment
          in quarterly surveys.
        </div>
      </div>

      <!-- SocialCode -->
      <div class="space-y-3">
        <div class="flex flex-col sm:flex-row sm:items-baseline justify-between border-b border-slate-800/80 pb-2">
          <div>
            <h3 class="text-lg font-bold text-white">Lead TechOps Engineer</h3>
            <p class="text-sm font-medium text-sky-400">
              SocialCode <span class="text-slate-400">•</span> Washington, DC
            </p>
          </div>
          <span class="text-xs text-slate-300 font-mono mt-1 sm:mt-0">
            Aug 2013 – Jul 2020
          </span>
        </div>
        <p class="text-xs font-mono text-slate-300">
          Technologies: AWS, Docker, Python, Bash, ELK, Jenkins, Chef, Ubuntu,
          CloudFormation, Lambda, CloudWatch, HashiCorp Vault
        </p>
        <ul class="list-disc list-outside pl-5 space-y-1.5 text-sm text-slate-300">
          <li>
            Mentored engineers; set annual objectives and decomposed them into
            deliverable projects and tasks.
          </li>
          <li>
            Embedded as a technical resource on Audience Intelligence
            engineering sprints; bridged DevOps with product engineering.
          </li>
          <li>
            Built a secure AWS environment (CloudFormation) for PII processing
            from first principles in a new account; aligned with security and
            compliance requirements.
          </li>
          <li>
            Served as technical point of contact for identity resolution/data
            ingestion pipeline redevelopment; improved reliability and data
            integrity.
          </li>
          <li>
            Optimized cloud costs: deployed usage monitors; right-sized
            instances and storage; replaced EC2 cron hosts with Lambda-based
            serverless jobs; analyzed EC2/RDS reservations; automated recovery
            via CloudWatch alarms.
          </li>
          <li>
            Implemented secrets migration, standardization, and rotation from
            Chef encrypted databags to HashiCorp Vault in ECS.
          </li>
          <li>
            Architected centralized logging via ELK for system and application
            logs; extended stack functionality using open-source tools (e.g.,
            elastalert) to achieve alerting without enterprise licensing.
          </li>
          <li>
            Liaised with AWS Enterprise Support; coordinated learning sessions
            and led biweekly cadence calls for issue tracking and resolution.
          </li>
        </ul>
        <div class="bg-slate-900/50 p-3 rounded border border-slate-800 text-xs text-slate-300 space-y-1">
          <span class="font-semibold text-sky-400">Selected Outcomes:</span>
          <p>
            • Reduced operational toil and improved MTTR through centralized
            logging and actionable alerts.
          </p>
          <p>
            • Lowered infrastructure costs while increasing reliability via
            serverless job migration and reservation planning.
          </p>
        </div>
      </div>

      <!-- Catalist -->
      <div class="space-y-3">
        <div class="flex flex-col sm:flex-row sm:items-baseline justify-between border-b border-slate-800/80 pb-2">
          <div>
            <h3 class="text-lg font-bold text-white">
              Software Engineer, Team Lead
            </h3>
            <p class="text-sm font-medium text-sky-400">
              Catalist <span class="text-slate-400">•</span> Washington, DC
            </p>
          </div>
          <span class="text-xs text-slate-300 font-mono mt-1 sm:mt-0">
            Jan 2010 – Aug 2013
          </span>
        </div>
        <p class="text-xs font-mono text-slate-300">
          Technologies: Postgres/pgpool, Storm, Bash, Java, Drools, Solr/Lucene
        </p>
        <ul class="list-disc list-outside pl-5 space-y-1.5 text-sm text-slate-300">
          <li>
            Increased efficiency and maintainability of core data processing
            systems through refactoring and architectural upgrades.
          </li>
          <li>
            Migrated identity matching to pgpool/Postgres for scale and
            reliability; designed distributed merge pipelines using Storm to
            process person-level data at higher throughput and reduced latency.
          </li>
          <li>
            Automated recurring data pipelines using Drools flows; scripted
            operational tasks in Bash.
          </li>
          <li>
            Redeveloped legacy Java components, removing bottlenecks and
            improving performance.
          </li>
          <li>
            Conducted R&D on Solr/Lucene for identity matching; evaluated
            trade-offs against speed requirements; implemented Storm-based
            stream processing as the chosen path.
          </li>
          <li>
            Trained and mentored developers; cross-trained client-facing teams
            to spread domain knowledge and reduce ad-hoc requests.
          </li>
          <li>
            Managed projects including person-merge (Storm), analytics model
            generation upgrades, state voter file processing, and annual vendor
            data refresh.
          </li>
        </ul>
        <div class="bg-slate-900/50 p-3 rounded border border-slate-800 text-xs text-slate-300 space-y-1">
          <span class="font-semibold text-sky-400">Results:</span>
          <p>
            • Increased throughput of distributed data processing while
            decreasing end-to-end processing time.
          </p>
          <p>
            • Improved resilience and observability of pipelines, reducing
            manual interventions.
          </p>
        </div>
      </div>
    </section>

    <!-- EDUCATION & CERTIFICATIONS GRID -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <section class="space-y-3">
        <h2 class="text-xl font-bold text-white border-l-4 border-sky-400 pl-3">
          Education
        </h2>
        <div class="space-y-3 text-sm">
          <div>
            <p class="font-semibold text-slate-200">
              University of Maryland, College Park
            </p>
            <p class="text-xs text-slate-300">
              M.S., Computer Engineering (Aug 2006 – May 2008)
            </p>
          </div>
          <div>
            <p class="font-semibold text-slate-200">Clarkson University</p>
            <p class="text-xs text-slate-300">
              B.S., Computer & Electrical Engineering (Aug 2001 – Dec 2005)
            </p>
          </div>
        </div>
      </section>

      <section class="space-y-3">
        <h2 class="text-xl font-bold text-white border-l-4 border-sky-400 pl-3">
          Certifications & Training
        </h2>
        <ul class="list-disc list-outside pl-5 space-y-1.5 text-xs text-slate-300">
          <li>Proofpoint Certified Ransomware Specialist 2025</li>
          <li>SOC 2 audit support and evidence collection (Decile)</li>
          <li>AWS cost optimization practices (Savings Plans, Reservations)</li>
          <li>Incident response participation (annual exercises)</li>
        </ul>
      </section>
    </div>

    <!-- TECHNICAL TOOLBOX -->
    <section class="space-y-3">
      <h2 class="text-xl font-bold text-white border-l-4 border-sky-400 pl-3">
        Technical Toolbox
      </h2>
      <div class="flex flex-wrap gap-2 pt-2">
        {[
          "AWS (EC2, RDS, Lambda, VPC)",
          "IAM / SSO",
          "CloudFormation",
          "Terraform",
          "Jenkins",
          "Docker",
          "Chef",
          "Ubuntu",
          "ELK Stack",
          "New Relic",
          "Kibana",
          "Orca",
          "Qualys",
          "Snyk",
          "HashiCorp Vault",
          "Snowflake",
          "dbt Cloud",
          "Python",
          "Bash",
          "Kubernetes/EKS",
          "Airflow",
          "Fivetran",
          "Sentry",
          "CrowdStrike",
          "GuardDuty",
          "Claude Code",
        ].map((item) => (
          <span class="px-3 py-1 bg-slate-900 border border-slate-800 rounded-full text-xs font-mono text-slate-300">
            {item}
          </span>
        ))}
      </div>
    </section>

    <!-- INTERESTS & PERSONAL STATEMENT -->
    <section class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-4 border-t border-slate-800">
      <div class="space-y-2">
        <h3 class="text-sm font-bold text-white uppercase tracking-wider">
          Interests
        </h3>
        <p class="text-xs text-slate-300 leading-relaxed">
          Photography (digital & film), hiking, yoga, meditation, travel,
          fantasy literature, architecture, dogs, concerts, cooking, baking
        </p>
      </div>
      <div class="space-y-2">
        <h3 class="text-sm font-bold text-white uppercase tracking-wider">
          Personal Statement
        </h3>
        <p class="text-xs text-slate-300 leading-relaxed italic">
          "I thrive with curious, collaborative teammates who share knowledge
          and also know how to switch off 'work mode' to enjoy life. Outside
          work, I spend time with my husband and our beagle & jack
          chi—gardening, hiking, and exploring DC."
        </p>
      </div>
    </section>
  </main>
</Layout>
