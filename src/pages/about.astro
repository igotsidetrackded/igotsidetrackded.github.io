---
// src/pages/about.astro
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";

// Import local image from src/assets/photography/
import bryanAvatar from "../assets/photography/bryan_avatar.jpg";

// Public assets are served directly from /assets/interior/
const addamAvatarPath = "/assets/interior/addam_avatar.jpg";

// Define subpage links for floating navigation
const navLinks = [
  { href: "/about", label: "About" },
  { href: "/interior", label: "Interior Design Services" },
  { href: "/photo", label: "Photography" },
  { href: "/resume", label: "Bry's Resume" },
  { href: "/contact", label: "Contact" },
];
---

<Layout
  title="About | Schauer-Mayhew designs"
  description="Learn about Schauer-Mayhew designs (SMd.), a creative partnership between Addam Mayhew and Bryan Schauer blending interior design and photography."
>
  <!-- FIXED HAMBURGER MENU CONTAINER -->
  <div class="fixed top-6 right-6 z-50">
    <button
      id="menu-btn"
      type="button"
      class="p-3 rounded-full bg-slate-900/80 border border-slate-800 text-slate-300 hover:text-white hover:border-slate-700 transition backdrop-blur-md shadow-lg flex items-center justify-center focus:outline-none focus:ring-2 focus:ring-sky-400"
      aria-label="Toggle Navigation"
      aria-expanded="false"
    >
      <svg
        id="icon-hamburger"
        class="w-5 h-5 block"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h16M4 18h16"
        ></path>
      </svg>
      <svg
        id="icon-close"
        class="w-5 h-5 hidden"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M6 18L18 6M6 6l12 12"
        ></path>
      </svg>
    </button>

    <nav
      id="menu-panel"
      class="hidden absolute right-0 mt-3 w-56 bg-slate-900/95 border border-slate-800 rounded-2xl p-3 shadow-2xl backdrop-blur-xl space-y-1 text-sm font-medium"
    >
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="block px-4 py-2.5 rounded-xl text-slate-300 hover:text-white hover:bg-slate-800/80 transition"
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>

  <main class="max-w-4xl mx-auto px-6 py-12 space-y-12">
    <!-- NAVIGATION & HEADER -->
    <header class="space-y-4 border-b border-slate-800 pb-8">
      <a
        href="/"
        class="inline-flex items-center text-sm font-medium text-sky-400 hover:text-sky-300 transition"
      >
        ← Back to main site
      </a>
      <div>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
          About Schauer-Mayhew designs
        </h1>
        <p class="text-lg font-medium text-sky-400 mt-1">Meet Addam and Bry</p>
      </div>
    </header>

    <!-- OUR STORY -->
    <section class="space-y-3">
      <h2 class="text-xl font-bold text-white border-l-4 border-sky-400 pl-3">
        Our Story
      </h2>
      <p class="text-slate-300 text-base sm:text-lg leading-relaxed">
        Schauer-Mayhew designs (SMd.) is a creative partnership between Addam
        Mayhew and Bryan Schauer, blending interior design and photography to
        elevate spaces and experiences.
      </p>
    </section>

    <!-- TEAM PROFILES GRID -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 pt-4">
      <!-- ADDAM MAYHEW -->
      <article class="p-6 bg-slate-900 border border-slate-800 rounded-xl space-y-5 flex flex-col justify-between">
        <div class="space-y-4">
          <div class="flex items-center gap-4">
            <img
              src={addamAvatarPath}
              alt="Addam Mayhew"
              class="w-16 h-16 rounded-full object-cover border-2 border-sky-400/30"
            />
            <div>
              <h3 class="text-xl font-bold text-white">Addam Mayhew</h3>
              <p class="text-xs font-semibold text-sky-400 uppercase tracking-wider">
                Interior Design & Project Management
              </p>
            </div>
          </div>
          <p class="text-slate-300 text-sm leading-relaxed">
            From a young age, Addam knew they wanted to work in design, with
            interior design as the happy mix of their deep love of art and
            architecture. They enjoy transforming a client’s needs and wants
            into reality. When Addam is not working, you can find them at an
            estate sale/antiquing, visiting museums, hiking, biking, and
            gardening. Addam and Bry live in the Kingman Park neighborhood of
            northeast DC. Their lemon beagle, Teagan, sits on the arm of the
            sofa near a window and acts as mayor of their street.
          </p>
        </div>
        <div class="pt-2 border-t border-slate-800/80">
          <a
            href="/alm-portfolio"
            class="text-xs font-medium text-sky-400 hover:text-sky-300 transition inline-flex items-center gap-1"
          >
            View Addam's Portfolio →
          </a>
        </div>
      </article>

      <!-- BRYAN SCHAUER -->
      <article class="p-6 bg-slate-900 border border-slate-800 rounded-xl space-y-5 flex flex-col justify-between">
        <div class="space-y-4">
          <div class="flex items-center gap-4">
            <Image
              src={bryanAvatar}
              alt="Bryan Schauer-Mayhew"
              class="w-16 h-16 rounded-full object-cover border-2 border-sky-400/30"
            />
            <div>
              <h3 class="text-xl font-bold text-white">Bryan Schauer</h3>
              <p class="text-xs font-semibold text-sky-400 uppercase tracking-wider">
                DevSecOps & Photography
              </p>
            </div>
          </div>
          <p class="text-slate-300 text-sm leading-relaxed">
            Bry’s always had an interest in computers, initially in hardware,
            but quickly moving to software during grad school. For the past
            decade, he’s been working in DevOps, managing cloud infrastructure
            and security. He found his way behind a camera after taking digital
            photography and darkroom classes at Capitol Hill Arts Workshop. When
            Bry isn’t in front of a screen, you can find him practicing
            yoga/mindfulness, visiting museums, hiking, biking, or walking the
            dog. Bry and Addam live in the Kingman Park neighborhood of
            northeast DC along with their lemon beagle, Teagan.
          </p>
        </div>
        <div class="pt-2 border-t border-slate-800/80">
          <a
            href="/photo"
            class="text-xs font-medium text-sky-400 hover:text-sky-300 transition inline-flex items-center gap-1"
          >
            View Bry's Photography →
          </a>
        </div>
      </article>
    </div>

    <!-- WHY SMD & CTA -->
    <section class="space-y-6 pt-6 border-t border-slate-800">
      <div class="space-y-3">
        <h2 class="text-xl font-bold text-white border-l-4 border-sky-400 pl-3">
          Why SMd.?
        </h2>
        <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
          Together, Addam and Bry offer a unique blend of design and visual
          storytelling, helping clients realize their vision from concept to
          completion.
        </p>
      </div>

      <div class="bg-slate-900/60 border border-slate-800 p-6 rounded-xl flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h3 class="text-base font-semibold text-white">
            Have a project in mind?
          </h3>
          <p class="text-xs text-slate-300">
            Get in touch with us to learn more or start working together.
          </p>
        </div>
        <a
          href="/contact"
          class="inline-flex items-center justify-center px-5 py-2.5 bg-sky-500 hover:bg-sky-400 text-slate-950 font-semibold text-sm rounded-lg transition shadow-sm whitespace-nowrap"
        >
          Contact Us
        </a>
      </div>
    </section>
  </main>

  <!-- CLIENT-SIDE SCRIPT FOR TOGGLE & OUTSIDE CLICK -->
  <script>
    function setupMenu() {
      const btn = document.getElementById("menu-btn");
      const panel = document.getElementById("menu-panel");
      const iconHamburger = document.getElementById("icon-hamburger");
      const iconClose = document.getElementById("icon-close");

      if (!btn || !panel || !iconHamburger || !iconClose) return;

      function toggleMenu() {
        const isOpen = !panel.classList.contains("hidden");
        if (isOpen) {
          panel.classList.add("hidden");
          iconHamburger.classList.remove("hidden");
          iconClose.classList.add("hidden");
          btn?.setAttribute("aria-expanded", "false");
        } else {
          panel.classList.remove("hidden");
          iconHamburger.classList.add("hidden");
          iconClose.classList.remove("hidden");
          btn?.setAttribute("aria-expanded", "true");
        }
      }

      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        toggleMenu();
      });

      document.addEventListener("click", (e) => {
        if (
          !panel.contains(e.target as Node) &&
          !btn.contains(e.target as Node)
        ) {
          panel.classList.add("hidden");
          iconHamburger.classList.remove("hidden");
          iconClose.classList.add("hidden");
          btn.setAttribute("aria-expanded", "false");
        }
      });
    }

    setupMenu();
    document.addEventListener("astro:page-load", setupMenu);
  </script>
</Layout>
