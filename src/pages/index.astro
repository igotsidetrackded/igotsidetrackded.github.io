---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import natureImg from "../assets/photography/nature.jpg";
import archImg from "../assets/photography/arch.jpg";
import bwImg from "../assets/photography/bw.jpg";

---

<Layout title="Bryan Schauer-Mayhew | DevSecOps & Personal Hub">
  <main class="max-w-4xl mx-auto px-6 py-16 space-y-20">
    <!-- HERO SECTION -->
    <section class="space-y-4">
      <div class="space-y-6">
        <!-- Header with accent color on the name -->
        <div class="space-y-2">
          <h1 class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight">
            Hey, I’m <span class="text-sky-400">Bryan Schauer-Mayhew</span>.
          </h1>
          <p class="text-sm sm:text-base text-slate-300 italic">
            (Yes, <span class="text-sky-400">Schauer-Mayhew</span> for the URL,
            but <span class="text-sky-400">Bry</span> or{" "}
            <span class="text-sky-400">Schauer</span> works day-to-day).
          </p>
        </div>

        <!-- Intro Paragraphs with breathing room -->
        <div class="space-y-3 text-slate-300">
          <p class="text-lg leading-relaxed">
            DevSecOps Engineer by day. Photog, hiker, yogi, and dog dad all the
            time!
          </p>
          <p class="text-lg leading-relaxed">
            Building secure cloud environments and exploring the outdoors.
          </p>
        </div>
      </div>
    </section>

    <!-- MODULAR INTERESTS GRID -->
    <section class="grid md:grid-cols-3 gap-6">
      <div class="bg-slate-900 p-6 rounded-xl border border-slate-800 hover:border-slate-700 transition">
        <h2 class="text-xl font-bold text-sky-400 mb-2">
          Engineering & Security
        </h2>
        <p class="text-slate-300 text-sm">
          Focusing on CI/CD security, automation, cloud infrastructure, and
          DevSecOps best practices.
        </p>
      </div>

      <div class="bg-slate-900 p-6 rounded-xl border border-slate-800 hover:border-slate-700 transition">
        <h2 class="text-xl font-bold text-emerald-400 mb-2">
          Outdoors & Movement
        </h2>
        <p class="text-slate-300 text-sm">
          Hiking local trails, practicing yoga and meditation, and soaking up
          the outdoors.
        </p>
      </div>

      <div class="bg-slate-900 p-6 rounded-xl border border-slate-800 hover:border-slate-700 transition">
        <h2 class="text-xl font-bold text-purple-400 mb-2">Life & Community</h2>
        <p class="text-slate-300 text-sm">
          Spending time with my husband and our two dogs, enjoying a game of
          mahjong, walking our neighborhood parks, and catching up with friends.
        </p>
      </div>
    </section>

    <!-- PHOTOGRAPHY PREVIEW SECTION -->
    <section class="space-y-6">
      <div class="flex justify-between items-end">
        <h2 class="text-2xl font-bold text-white">Featured Photography</h2>
        <span class="text-xs text-slate-300 uppercase tracking-wider">
          Gallery
        </span>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
        <Image
          src={natureImg}
          alt="Nature landscape photography by Bryan Schauer"
          class="aspect-square object-cover rounded-lg border border-slate-800"
        />
        <Image
          src={archImg}
          alt="Architectural photography by Bryan Schauer"
          class="aspect-square object-cover rounded-lg border border-slate-800"
        />
        <Image
          src={bwImg}
          alt="Black and white photography by Bryan Schauer"
          class="aspect-square object-cover rounded-lg border border-slate-800"
        />
      </div>
    </section>

    <!-- FOOTER / CONNECT -->
    <footer class="pt-8 border-t border-slate-800 flex justify-between items-center text-sm text-slate-400">
      <p>© {new Date().getFullYear()} Bryan Schauer</p>
      <div class="space-x-4">
        <a
          href="https://github.com/igotsidetrackded"
          target="_blank"
          class="hover:text-sky-400 transition"
        >
          GitHub
        </a>
        <a
          href="https://linkedin.com/in/schauebc"
          class="hover:text-sky-400 transition"
        >
          LinkedIn
        </a>
      </div>
    </footer>
  </main>
</Layout>
