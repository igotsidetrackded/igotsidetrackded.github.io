---
// src/pages/alm-portfolio.astro
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";

// Import hero image from assets
import kitchenCadImg from "../assets/interior/kitchen_cad_ai_gen.png";

// Define subpage links for floating navigation
const navLinks = [
  { href: "/about", label: "About" },
  { href: "/interior", label: "Interior Design Services" },
  { href: "/photo", label: "Photography" },
  { href: "/resume", label: "Bry's Resume" },
  { href: "/contact", label: "Contact" },
];
---

<Layout
  title="ALM Portfolio | Addam Mayhew Interior Design"
  description="View the interior design slide deck portfolio for Addam Mayhew featuring kitchen CADs, material palettes, space plans, and finished projects."
>
  <!-- FIXED HAMBURGER MENU CONTAINER -->
  <div class="fixed top-6 right-6 z-50">
    <button
      id="menu-btn"
      type="button"
      class="p-3 rounded-full bg-slate-900/80 border border-slate-800 text-slate-300 hover:text-white hover:border-slate-700 transition backdrop-blur-md shadow-lg flex items-center justify-center focus:outline-none focus:ring-2 focus:ring-sky-400"
      aria-label="Toggle Navigation"
      aria-expanded="false"
    >
      <svg
        id="icon-hamburger"
        class="w-5 h-5 block"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h16M4 18h16"
        ></path>
      </svg>
      <svg
        id="icon-close"
        class="w-5 h-5 hidden"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M6 18L18 6M6 6l12 12"
        ></path>
      </svg>
    </button>

    <nav
      id="menu-panel"
      class="hidden absolute right-0 mt-3 w-56 bg-slate-900/95 border border-slate-800 rounded-2xl p-3 shadow-2xl backdrop-blur-xl space-y-1 text-sm font-medium"
    >
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="block px-4 py-2.5 rounded-xl text-slate-300 hover:text-white hover:bg-slate-800/80 transition"
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>

  <!-- HEADER / HERO OVERLAY -->
  <div class="relative w-full h-64 sm:h-80 md:h-96 overflow-hidden border-b border-slate-800">
    <Image
      src={kitchenCadImg}
      alt="3D CAD architectural model rendering of a modern kitchen design by Addam Mayhew"
      class="w-full h-full object-cover object-center brightness-75"
    />
    <div class="absolute inset-0 bg-slate-950/60 backdrop-blur-[2px] flex items-center">
      <div class="max-w-4xl mx-auto px-6 w-full space-y-2">
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight">
          ALM Portfolio
        </h1>
        <p class="text-base sm:text-lg text-slate-300 max-w-2xl">
          A curated selection of Addam’s interior design work.
        </p>
      </div>
    </div>
  </div>

  <!-- MAIN CONTENT CONTAINER -->
  <main class="max-w-4xl mx-auto px-6 py-12 space-y-8">
    <!-- NAVIGATION & INTRO -->
    <div class="space-y-4">
      <a
        href="/"
        class="inline-flex items-center text-sm font-medium text-sky-400 hover:text-sky-300 transition"
      >
        ← Back to main site
      </a>
      <p class="text-slate-300 text-base leading-relaxed">
        This portfolio presents selected interior design projects, highlighting
        space planning, material palettes, and finished environments.
      </p>
    </div>

    <!-- ACTION BUTTONS -->
    <div class="flex flex-wrap gap-4 pt-2">
      <a
        href="https://docs.google.com/presentation/d/e/2PACX-1vQu-0iVbO77vBLlZuAY0EZWK-g5_KjZmwzNt0L2ZHC4oZ2Ulrrz4A4oXlnmPQsteZF3IZWj6k-44UxW/pub?start=false&loop=true&delayms=3000"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center px-5 py-2.5 rounded-lg text-sm font-semibold bg-sky-500 text-slate-950 hover:bg-sky-400 transition shadow-sm"
      >
        Open Slides
      </a>
    </div>

    <!-- RESPONSIVE SLIDES EMBED -->
    <div class="space-y-2 pt-4">
      <div class="relative w-full aspect-video bg-slate-900 rounded-xl overflow-hidden border border-slate-800 shadow-xl">
        <iframe
          title="ALM portfolio presentation"
          src="https://docs.google.com/presentation/d/e/2PACX-1vQu-0iVbO77vBLlZuAY0EZWK-g5_KjZmwzNt0L2ZHC4oZ2Ulrrz4A4oXlnmPQsteZF3IZWj6k-44UxW/pubembed?start=false&loop=true&delayms=3000"
          class="absolute inset-0 w-full h-full border-0"
          allowfullscreen="true"
          mozallowfullscreen="true"
          webkitallowfullscreen="true"
        ></iframe>
      </div>
      <p class="text-xs text-slate-300 italic">
        Tip: use full screen for best viewing.
      </p>
    </div>
  </main>

  <!-- CLIENT-SIDE SCRIPT FOR TOGGLE & OUTSIDE CLICK -->
  <script>
    function setupMenu() {
      const btn = document.getElementById("menu-btn");
      const panel = document.getElementById("menu-panel");
      const iconHamburger = document.getElementById("icon-hamburger");
      const iconClose = document.getElementById("icon-close");

      if (!btn || !panel || !iconHamburger || !iconClose) return;

      function toggleMenu() {
        const isOpen = !panel.classList.contains("hidden");
        if (isOpen) {
          panel.classList.add("hidden");
          iconHamburger.classList.remove("hidden");
          iconClose.classList.add("hidden");
          btn?.setAttribute("aria-expanded", "false");
        } else {
          panel.classList.remove("hidden");
          iconHamburger.classList.add("hidden");
          iconClose.classList.remove("hidden");
          btn?.setAttribute("aria-expanded", "true");
        }
      }

      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        toggleMenu();
      });

      document.addEventListener("click", (e) => {
        if (
          !panel.contains(e.target as Node) &&
          !btn.contains(e.target as Node)
        ) {
          panel.classList.add("hidden");
          iconHamburger.classList.remove("hidden");
          iconClose.classList.add("hidden");
          btn.setAttribute("aria-expanded", "false");
        }
      });
    }

    setupMenu();
    document.addEventListener("astro:page-load", setupMenu);
  </script>
</Layout>
