---
// src/pages/contact.astro
import Layout from "../layouts/Layout.astro";

---

<Layout
  title="Contact | Bryan & Addam"
  description="Get in touch with Addam Mayhew for interior design inquiries or Bryan Schauer for DevSecOps consulting and photography."
>
  <main class="max-w-4xl mx-auto px-6 py-12 space-y-12">
    <!-- NAVIGATION & HEADER -->
    <header class="space-y-4 border-b border-slate-800 pb-8">
      <a
        href="/"
        class="inline-flex items-center text-sm font-medium text-sky-400 hover:text-sky-300 transition"
      >
        ← Back to main site
      </a>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        Get in Touch
      </h1>
      <p class="text-slate-300 text-base">
        Reach out directly via email or social channels, or send us a quick
        message using the form below.
      </p>
    </header>

    <!-- DIRECT CONTACT CARDS -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Addam -->
      <div class="p-6 bg-slate-900 border border-slate-800 rounded-xl space-y-4 shadow-sm">
        <div>
          <h2 class="text-lg font-bold text-white">Addam Mayhew</h2>
          <p class="text-xs font-semibold text-sky-400 uppercase tracking-wider">
            Interior Design & Project Management
          </p>
        </div>
        <ul class="space-y-2 text-sm">
          <li>
            <a
              href="mailto:addam@schauermayhew.com"
              class="text-slate-300 hover:text-sky-400 transition flex items-center gap-2"
            >
              <span class="text-sky-400">✉</span> addam@schauermayhew.com
            </a>
          </li>
          <li>
            <a
              href="https://www.linkedin.com/in/addam-mayhew-8669b123/"
              target="_blank"
              rel="noopener noreferrer"
              class="text-slate-300 hover:text-sky-400 transition flex items-center gap-2"
            >
              <span class="text-sky-400">🔗</span> LinkedIn
            </a>
          </li>
        </ul>
      </div>

      <!-- Bryan -->
      <div class="p-6 bg-slate-900 border border-slate-800 rounded-xl space-y-4 shadow-sm">
        <div>
          <h2 class="text-lg font-bold text-white">Bryan Schauer</h2>
          <p class="text-xs font-semibold text-sky-400 uppercase tracking-wider">
            DevSecOps & Photography
          </p>
        </div>
        <ul class="space-y-2 text-sm">
          <li>
            <a
              href="mailto:bryan@schauermayhew.com"
              class="text-slate-300 hover:text-sky-400 transition flex items-center gap-2"
            >
              <span class="text-sky-400">✉</span> bryan@schauermayhew.com
            </a>
          </li>
          <li>
            <a
              href="https://linkedin.com/in/schauebc"
              target="_blank"
              rel="noopener noreferrer"
              class="text-slate-300 hover:text-sky-400 transition flex items-center gap-2"
            >
              <span class="text-sky-400">🔗</span> LinkedIn
            </a>
          </li>
          <li>
            <a
              href="https://flickr.com/schauebc"
              target="_blank"
              rel="noopener noreferrer"
              class="text-slate-300 hover:text-sky-400 transition flex items-center gap-2"
            >
              <span class="text-sky-400">📷</span> Flickr
            </a>
          </li>
          <li>
            <a
              href="https://bsky.app/profile/igotsidetrackded.bsky.social"
              target="_blank"
              rel="noopener noreferrer"
              class="text-slate-300 hover:text-sky-400 transition flex items-center gap-2"
            >
              <span class="text-sky-400">🦋</span> Bluesky
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- CONTACT FORM SECTION -->
    <section class="space-y-6 pt-6 border-t border-slate-800">
      <div class="space-y-1">
        <h2 class="text-xl font-bold text-white">Send a Message</h2>
        <p class="text-sm text-slate-300">
          Fill out the form below and we will get back to you shortly.
        </p>
      </div>

      <form
        id="contact-form"
        action="https://formspree.io/f/xjkawgrk"
        method="POST"
        class="space-y-5 max-w-2xl"
      >
        <!-- Name -->
        <div class="space-y-1.5">
          <label
            for="name"
            class="block text-xs font-semibold uppercase tracking-wider text-slate-300"
          >
            Name
          </label>
          <input
            id="name"
            name="name"
            type="text"
            required
            autocomplete="name"
            placeholder="Your name"
            class="w-full px-4 py-2.5 bg-slate-900 border border-slate-800 rounded-lg text-slate-100 placeholder-slate-400 focus:outline-none focus:border-sky-400 focus:ring-1 focus:ring-sky-400 transition text-sm"
          />
        </div>

        <!-- Email -->
        <div class="space-y-1.5">
          <label
            for="email"
            class="block text-xs font-semibold uppercase tracking-wider text-slate-300"
          >
            Email Address
          </label>
          <input
            id="email"
            name="_replyto"
            type="email"
            required
            autocomplete="email"
            placeholder="you@example.com"
            class="w-full px-4 py-2.5 bg-slate-900 border border-slate-800 rounded-lg text-slate-100 placeholder-slate-400 focus:outline-none focus:border-sky-400 focus:ring-1 focus:ring-sky-400 transition text-sm"
          />
        </div>

        <!-- Message -->
        <div class="space-y-1.5">
          <label
            for="message"
            class="block text-xs font-semibold uppercase tracking-wider text-slate-300"
          >
            Message
          </label>
          <textarea
            id="message"
            name="message"
            rows="5"
            required
            placeholder="How can we help you?"
            class="w-full px-4 py-2.5 bg-slate-900 border border-slate-800 rounded-lg text-slate-100 placeholder-slate-400 focus:outline-none focus:border-sky-400 focus:ring-1 focus:ring-sky-400 transition text-sm"
          ></textarea>
        </div>

        <!-- Spam Honeypot -->
        <input
          type="text"
          name="_gotcha"
          class="hidden"
          tabindex="-1"
          autocomplete="off"
        />

        <!-- Formspree Config -->
        <input
          type="hidden"
          name="_subject"
          value="New contact form submission"
        />
        <input type="hidden" name="_format" value="json" />

        <!-- Submit Button -->
        <button
          type="submit"
          class="px-6 py-2.5 bg-sky-500 hover:bg-sky-400 text-slate-950 font-semibold text-sm rounded-lg transition shadow-sm cursor-pointer"
        >
          Send Message
        </button>
      </form>

      <!-- Status Indicator -->
      <p
        id="form-status"
        class="text-sm font-medium pt-2"
        role="status"
        aria-live="polite"
      ></p>
    </section>
  </main>
</Layout>
