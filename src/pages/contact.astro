---
// src/pages/contact.astro
import Layout from "../layouts/Layout.astro";

// Define subpage links for floating navigation
const navLinks = [
  { href: "/about", label: "About" },
  { href: "/interior", label: "Interior Design Services" },
  { href: "/photo", label: "Photography" },
  { href: "/resume", label: "Bry's Resume" },
  { href: "/contact", label: "Contact" },
];
---

<Layout
  title="Contact | Bryan & Addam"
  description="Get in touch with Addam Mayhew for interior design inquiries or Bryan Schauer for DevSecOps consulting and photography."
>
  <!-- FIXED HAMBURGER MENU CONTAINER -->
  <div class="fixed top-6 right-6 z-50">
    <button
      id="menu-btn"
      type="button"
      class="p-3 rounded-full bg-slate-900/80 border border-slate-800 text-slate-300 hover:text-white hover:border-slate-700 transition backdrop-blur-md shadow-lg flex items-center justify-center focus:outline-none focus:ring-2 focus:ring-sky-400"
      aria-label="Toggle Navigation"
      aria-expanded="false"
    >
      <svg
        id="icon-hamburger"
        class="w-5 h-5 block"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h16M4 18h16"
        ></path>
      </svg>
      <svg
        id="icon-close"
        class="w-5 h-5 hidden"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M6 18L18 6M6 6l12 12"
        ></path>
      </svg>
    </button>

    <nav
      id="menu-panel"
      class="hidden absolute right-0 mt-3 w-56 bg-slate-900/95 border border-slate-800 rounded-2xl p-3 shadow-2xl backdrop-blur-xl space-y-1 text-sm font-medium"
    >
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="block px-4 py-2.5 rounded-xl text-slate-300 hover:text-white hover:bg-slate-800/80 transition"
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>

  <main class="max-w-4xl mx-auto px-6 py-12 space-y-12">
    <!-- NAVIGATION & HEADER -->
    <header class="space-y-4 border-b border-slate-800 pb-8">
      <a
        href="/"
        class="inline-flex items-center text-sm font-medium text-sky-400 hover:text-sky-300 transition"
      >
        ← Back to main site
      </a>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        Get in Touch
      </h1>
      <p class="text-slate-300 text-base">
        Reach out directly via email or social channels, or send us a quick
        message using the form below.
      </p>
    </header>

    <!-- DIRECT CONTACT CARDS -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Addam -->
      <div class="p-6 bg-slate-900 border border-slate-800 rounded-xl space-y-4 shadow-sm">
        <div>
          <h2 class="text-lg font-bold text-white">Addam Mayhew</h2>
          <p class="text-xs font-semibold text-sky-400 uppercase tracking-wider">
            Interior Design
          </p>
        </div>
        <ul class="space-y-2 text-sm">
          <li>
            <a
              href="mailto:addam@schauermayhew.com"
              class="text-slate-300 hover:text-sky-400 transition flex items-center gap-2"
            >
              <span class="text-sky-400">✉</span> addam@schauermayhew.com
            </a>
          </li>
          <li>
            <a
              href="https://www.linkedin.com/in/addam-mayhew-8669b123/"
              target="_blank"
              rel="noopener noreferrer"
              class="text-slate-300 hover:text-sky-400 transition flex items-center gap-2"
            >
              <span class="text-sky-400">🔗</span> LinkedIn
            </a>
          </li>
        </ul>
      </div>

      <!-- Bryan -->
      <div class="p-6 bg-slate-900 border border-slate-800 rounded-xl space-y-4 shadow-sm">
        <div>
          <h2 class="text-lg font-bold text-white">Bryan Schauer</h2>
          <p class="text-xs font-semibold text-sky-400 uppercase tracking-wider">
            DevSecOps & Photography
          </p>
        </div>
        <ul class="space-y-2 text-sm">
          <li>
            <a
              href="mailto:bryan@schauermayhew.com"
              class="text-slate-300 hover:text-sky-400 transition flex items-center gap-2"
            >
              <span class="text-sky-400">✉</span> bryan@schauermayhew.com
            </a>
          </li>
          <li>
            <a
              href="https://linkedin.com/in/schauebc"
              target="_blank"
              rel="noopener noreferrer"
              class="text-slate-300 hover:text-sky-400 transition flex items-center gap-2"
            >
              <span class="text-sky-400">🔗</span> LinkedIn
            </a>
          </li>
          <li>
            <a
              href="https://flickr.com/schauebc"
              target="_blank"
              rel="noopener noreferrer"
              class="text-slate-300 hover:text-sky-400 transition flex items-center gap-2"
            >
              <span class="text-sky-400">📷</span> Flickr
            </a>
          </li>
          <li>
            <a
              href="https://bsky.app/profile/igotsidetrackded.bsky.social"
              target="_blank"
              rel="noopener noreferrer"
              class="text-slate-300 hover:text-sky-400 transition flex items-center gap-2"
            >
              <span class="text-sky-400">🦋</span> Bluesky
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- CONTACT FORM SECTION -->
    <section class="space-y-6 pt-6 border-t border-slate-800">
      <div class="space-y-1">
        <h2 class="text-xl font-bold text-white">Send a Message</h2>
        <p class="text-sm text-slate-300">
          Fill out the form below and we will get back to you shortly.
        </p>
      </div>

      <form
        id="contact-form"
        action="https://formspree.io/f/xjkawgrk"
        method="POST"
        class="space-y-5 max-w-2xl"
      >
        <!-- Name -->
        <div class="space-y-1.5">
          <label
            for="name"
            class="block text-xs font-semibold uppercase tracking-wider text-slate-300"
          >
            Name
          </label>
          <input
            id="name"
            name="name"
            type="text"
            required
            autocomplete="name"
            placeholder="Your name"
            class="w-full px-4 py-2.5 bg-slate-900 border border-slate-800 rounded-lg text-slate-100 placeholder-slate-400 focus:outline-none focus:border-sky-400 focus:ring-1 focus:ring-sky-400 transition text-sm"
          />
        </div>

        <!-- Email -->
        <div class="space-y-1.5">
          <label
            for="email"
            class="block text-xs font-semibold uppercase tracking-wider text-slate-300"
          >
            Email Address
          </label>
          <input
            id="email"
            name="_replyto"
            type="email"
            required
            autocomplete="email"
            placeholder="you@example.com"
            class="w-full px-4 py-2.5 bg-slate-900 border border-slate-800 rounded-lg text-slate-100 placeholder-slate-400 focus:outline-none focus:border-sky-400 focus:ring-1 focus:ring-sky-400 transition text-sm"
          />
        </div>

        <!-- Message -->
        <div class="space-y-1.5">
          <label
            for="message"
            class="block text-xs font-semibold uppercase tracking-wider text-slate-300"
          >
            Message
          </label>
          <textarea
            id="message"
            name="message"
            rows="5"
            required
            placeholder="How can we help you?"
            class="w-full px-4 py-2.5 bg-slate-900 border border-slate-800 rounded-lg text-slate-100 placeholder-slate-400 focus:outline-none focus:border-sky-400 focus:ring-1 focus:ring-sky-400 transition text-sm"
          ></textarea>
        </div>

        <!-- Spam Honeypot -->
        <input
          type="text"
          name="_gotcha"
          class="hidden"
          tabindex="-1"
          autocomplete="off"
        />

        <!-- Formspree Config -->
        <input
          type="hidden"
          name="_subject"
          value="New contact form submission"
        />
        <input type="hidden" name="_format" value="json" />

        <!-- Submit Button -->
        <button
          type="submit"
          class="px-6 py-2.5 bg-sky-500 hover:bg-sky-400 text-slate-950 font-semibold text-sm rounded-lg transition shadow-sm cursor-pointer"
        >
          Send Message
        </button>
      </form>

      <!-- Status Indicator -->
      <p
        id="form-status"
        class="text-sm font-medium pt-2"
        role="status"
        aria-live="polite"
      ></p>
    </section>
  </main>

  <!-- CLIENT-SIDE SCRIPT FOR TOGGLE & FORM SUBMISSION -->
  <script>
    function setupPage() {
      // Menu functionality
      const btn = document.getElementById("menu-btn");
      const panel = document.getElementById("menu-panel");
      const iconHamburger = document.getElementById("icon-hamburger");
      const iconClose = document.getElementById("icon-close");

      if (btn && panel && iconHamburger && iconClose) {
        function toggleMenu() {
          const isOpen = !panel.classList.contains("hidden");
          if (isOpen) {
            panel.classList.add("hidden");
            iconHamburger.classList.remove("hidden");
            iconClose.classList.add("hidden");
            btn?.setAttribute("aria-expanded", "false");
          } else {
            panel.classList.remove("hidden");
            iconHamburger.classList.add("hidden");
            iconClose.classList.remove("hidden");
            btn?.setAttribute("aria-expanded", "true");
          }
        }

        btn.addEventListener("click", (e) => {
          e.stopPropagation();
          toggleMenu();
        });

        document.addEventListener("click", (e) => {
          if (
            !panel.contains(e.target as Node) &&
            !btn.contains(e.target as Node)
          ) {
            panel.classList.add("hidden");
            iconHamburger.classList.remove("hidden");
            iconClose.classList.add("hidden");
            btn.setAttribute("aria-expanded", "false");
          }
        });
      }

      // AJAX form submission logic
      const form = document.getElementById(
        "contact-form",
      ) as HTMLFormElement | null;
      const statusEl = document.getElementById("form-status");

      function setStatus(message: string, isError = false) {
        if (!statusEl) return;
        statusEl.textContent = message;
        statusEl.className = `text-sm font-medium pt-2 ${isError ? "text-rose-400" : "text-emerald-400"}`;
      }

      if (form) {
        form.addEventListener("submit", async function (e) {
          e.preventDefault();
          setStatus("Sending...");
          const data = new FormData(form);

          try {
            const res = await fetch(form.action, {
              method: "POST",
              headers: { Accept: "application/json" },
              body: data,
            });

            if (res.ok) {
              form.reset();
              setStatus("Thanks! Your message has been sent.");
            } else {
              const payload = await res.json().catch(() => ({}));
              const err =
                (payload &&
                  payload.errors &&
                  payload.errors[0] &&
                  payload.errors[0].message) ||
                "Something went wrong. Please try again.";
              setStatus(err, true);
            }
          } catch (err) {
            setStatus(
              "Network error. Please check your connection and try again.",
              true,
            );
          }
        });
      }
    }

    setupPage();
    document.addEventListener("astro:page-load", setupPage);
  </script>
</Layout>
